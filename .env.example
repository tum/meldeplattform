APP_NAME="TUM SafeSignal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=de
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meldeplattform
DB_USERNAME=meldeplattform
DB_PASSWORD=secret

CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Report notifications are dispatched on the queue. The `sync` driver runs
# them inline on the request (fine for dev). In PRODUCTION set this to a
# real backend (e.g. `database` or `redis`) AND run a worker
# (`php artisan queue:work`) so a slow/failing mail or webhook endpoint does
# not block submissions and so failed notifications are retried.
QUEUE_CONNECTION=sync

# Session hardening. Override SESSION_SECURE_COOKIE=true in production (HTTPS).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

MAIL_MAILER=smtp
MAIL_HOST=smtp.tum.de
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="meldeplattform@tum.de"
MAIL_FROM_NAME="${APP_NAME}"

# SAML2 Identity Provider settings
SAML2_IDP_ENTITYID=https://tumidp.lrz.de/idp/shibboleth
SAML2_IDP_METADATA_URL=https://login.tum.de/idp/shibboleth
SAML2_IDP_SSO_URL=https://login.tum.de/idp/profile/SAML2/Redirect/SSO
SAML2_IDP_SLO_URL=https://login.tum.de/idp/profile/Logout
SAML2_SP_ENTITYID="${APP_URL}/shib"
SAML2_SP_X509CERT=
SAML2_SP_PRIVATEKEY=
# PEM-encoded IdP signing certificate (body only, no BEGIN/END markers).
# REQUIRED in production. Without it the SP refuses to boot, because
# onelogin/php-saml would otherwise accept unsigned SAML responses.
SAML2_IDP_X509CERT=

# Comma-separated list of SAML UIDs that have global admin rights.
MELDE_ADMIN_USERS=
# Max upload size in MB.
MELDE_MAX_UPLOAD_MB=10
# Shared secret for signing outgoing webhook notifications (HMAC-SHA256,
# sent as `X-SafeSignal-Signature`). Leave empty to send unsigned.
MELDE_WEBHOOK_SECRET=

# OTRS / Znuny ticket integration (GenericInterface "Ticket Connector" REST).
# A topic routes to OTRS via its contacts JSON (contacts.otrs.queue). These set
# the shared connection + ticket defaults. UNLIKE email/webhook, this channel
# sends the FULL report content into the ticket, so MELDE_OTRS_BASE_URL MUST be
# https. Leave MELDE_OTRS_BASE_URL empty to disable OTRS entirely.
# base_url = the web-service base (note the trailing web-service name):
#   https://otrs.example.org/otrs/nph-genericinterface.pl/Webservice/GenericTicketConnectorREST
MELDE_OTRS_BASE_URL=
MELDE_OTRS_USER_LOGIN=
MELDE_OTRS_PASSWORD=
# Fallback queue for topics that don't set their own contacts.otrs.queue.
MELDE_OTRS_QUEUE=Raw
MELDE_OTRS_PRIORITY="3 normal"
MELDE_OTRS_STATE=new
MELDE_OTRS_CUSTOMER_USER=safesignal
# Optional OTRS ticket Type; leave empty to let OTRS use its default.
MELDE_OTRS_TYPE=
MELDE_OTRS_TIMEOUT=10
# Global data-retention window in days. Reports with no activity for longer
# than this are deleted by the scheduled `reports:prune` command. Individual
# topics can override via their own retention_days. Leave empty to keep
# reports indefinitely by default.
MELDE_DEFAULT_RETENTION_DAYS=

# EU Whistleblowing Directive deadlines (days from report creation).
# Acknowledge within 7 days, provide feedback within 3 months (~90 days).
#MELDE_ACK_DEADLINE_DAYS=7
#MELDE_FEEDBACK_DEADLINE_DAYS=90

# Dev login bypass. Must be explicitly enabled AND APP_ENV must not be
# "production". Leave unset / false in production deployments.
MELDE_DEV_LOGIN_ENABLED=false
