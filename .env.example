APP_NAME="TUM SafeSignal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=de
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=meldeplattform
DB_USERNAME=meldeplattform
DB_PASSWORD=secret

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Session hardening. Override SESSION_SECURE_COOKIE=true in production (HTTPS).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

MAIL_MAILER=smtp
MAIL_HOST=smtp.tum.de
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="meldeplattform@tum.de"
MAIL_FROM_NAME="${APP_NAME}"

# OIDC (TUM login). The discovery URL is the only required IdP setting in
# the happy path; the app fetches authorization/token/userinfo/jwks
# endpoints from this document at runtime and caches them. If the IdP
# does not publish a discovery document, set OIDC_AUTH_ENDPOINT,
# OIDC_TOKEN_ENDPOINT, OIDC_USERINFO_ENDPOINT, OIDC_JWKS_URI, and
# OIDC_END_SESSION_ENDPOINT explicitly (see config/oidc.php).
OIDC_DISCOVERY_URL=https://login.tum.de/.well-known/openid-configuration
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI="${APP_URL}/auth/callback"
OIDC_POST_LOGOUT_REDIRECT_URI="${APP_URL}/"
OIDC_SCOPES="openid profile email"
# Claim mapped to the local "uid" — TUM populates `preferred_username`
# with the kennung (e.g. ge42tum).
OIDC_USER_ID_CLAIM=preferred_username

# Comma-separated list of OIDC user IDs (matched against the claim
# selected by OIDC_USER_ID_CLAIM) that have global admin rights.
MELDE_ADMIN_USERS=
# Max upload size in MB.
MELDE_MAX_UPLOAD_MB=10

# Dev login bypass. Must be explicitly enabled AND APP_ENV must not be
# "production". Leave unset / false in production deployments.
MELDE_DEV_LOGIN_ENABLED=false
